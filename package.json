{
  "name": "grapnel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GRAPNEL — co-op grappling-vigilante mission. Swing prototype phase.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@colyseus/core": "0.16.24",
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "@dimforge/rapier3d-compat": "0.19.3",
    "colyseus.js": "0.16.22",
    "express": "^4.21.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/three": "^0.185.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vite": "^8.1.5"
  }
}
